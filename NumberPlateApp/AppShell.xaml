<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="NumberPlateApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:NumberPlateApp"
    xmlns:pages="clr-namespace:NumberPlateApp.Pages"
    Title="NumberPlateApp">

    <TabBar>
        <Tab Title="Home" Icon="home.png">
            <ShellContent                
                ContentTemplate="{DataTemplate local:MainPage}"
                Route="MainPage" />
        </Tab>
        <Tab Title="List" Icon="list.png">
            <ShellContent                
                ContentTemplate="{DataTemplate pages:ListPage}"
                Route="ListPage" />
        </Tab>
    </TabBar>
    

</Shell>
